rules_version = '2';

// Security model: the React client NEVER talks to Firestore directly. All reads
// and writes go through the Cloud Functions API, which uses the Admin SDK and
// therefore bypasses these rules. We deny every direct client access so that a
// leaked web API key cannot be used to read or tamper with link/analytics data.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
